# Copy to .env and fill only the integrations you intend to enable.
PORT=8765
PUBLIC_URL=http://localhost:8765
TUNSPRO_DB=./tunspro.sqlite3
COOKIE_SECURE=0

# Stripe Billing (use sk_test_... and a test webhook secret during development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Booking e-mail via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional SMS notifications via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
